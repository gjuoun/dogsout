{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!apps/web/src/styles.css"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noArrayIndexKey": "off"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useImportType": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/type-contracts/gen/**"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": [
				"apps/api/drizzle/**",
				"apps/api/openapi.json",
				"apps/web/.nitro/**",
				"apps/web/.output/**",
				"apps/web/src/routeTree.gen.ts",
				"apps/web/src/styles.css",
				"packages/api-client/src/generated/**"
			],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		}
	]
}
