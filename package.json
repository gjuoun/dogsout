{
	"name": "dogsout-workspace",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "turbo run test",
		"test:e2e": "bun tests/e2e.ts",
		"codegen": "bun scripts/codegen.ts",
		"drive:ui": "bun tests/drive-ui.ts",
		"check:bundle": "bun scripts/check-bundle.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@types/bun": "latest",
		"typescript": "^5.9.0",
		"turbo": "^2.11.0"
	}
}
